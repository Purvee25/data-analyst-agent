# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored so the secret never lands in version control.
#
# Locally, load it before running:  `export $(grep -v '^#' .env | xargs)`
# On Streamlit Community Cloud, set this instead in the app's Secrets UI.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults live in analyst/config.py):
# CLAUDE_MODEL=claude-sonnet-5
# ANALYST_LOG_DIR=logs

# --- Email-alert MCP action (optional feature) -------------------------------
# Required only if you want the "Email this insight" button in the UI to work.
# The local email_alert_server.py MCP process reads these directly; without
# them the action fails cleanly with a "missing SMTP env var" message.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=you@example.com
ALERT_EMAIL_TO=you@example.com
